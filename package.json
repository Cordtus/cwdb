{
  "name": "cwdb",
  "version": "2.0.0",
  "description": "gRPC-based indexer for CosmWasm contracts and NFT data",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --test tests/*.test.js",
    "test:pipeline": "node test_index.js",
    "lint": "eslint '**/*.js'",
    "lint:fix": "eslint '**/*.js' --fix"
  },
  "keywords": [
    "CosmWasm",
    "blockchain",
    "NFT",
    "CW721",
    "gRPC"
  ],
  "author": "Cordt Hanson",
  "license": "ISC",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "axios": "^1.7.3",
    "better-sqlite3": "^12.11.1",
    "p-limit": "^4.0.0",
    "protobufjs": "^8.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "eslint": "^8.45.0",
    "jest": "^29.0.0",
    "nodemon": "^2.0.15"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
